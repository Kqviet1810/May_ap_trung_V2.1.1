{
  "name": "mayap-push-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute mayap_push --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute mayap_push --remote --file=./schema.sql"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
